# ==============================================================================
# VIYOGI AGENTIC SEO SWARM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate with your credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATAFORSEO API CREDENTIALS
# ------------------------------------------------------------------------------
DATAFORSEO_LOGIN="your-dataforseo-login-email@example.com"
DATAFORSEO_PASSWORD="your-dataforseo-api-password"

# ------------------------------------------------------------------------------
# 2. GOOGLE CLOUD OAUTH 2.0 CREDENTIALS
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GSC_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GSC_CLIENT_SECRET="your-google-client-secret"
GSC_REFRESH_TOKEN="your-refresh-token"
GA4_PROPERTY_ID="your-numeric-ga4-property-id"

# ------------------------------------------------------------------------------
# 3. BING WEBMASTER TOOLS & INDEXNOW
# ------------------------------------------------------------------------------
BING_WEBMASTER_API_KEY="your-32-char-bing-api-key"
BING_INDEXNOW_KEY="your-32-char-indexnow-key"

# ------------------------------------------------------------------------------
# 4. SCRAPING & DECONSTRUCTION
# ------------------------------------------------------------------------------
FIRECRAWL_API_KEY="fc-your-firecrawl-api-key"

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE EDGE HOSTING (OPTIONAL)
# ------------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
